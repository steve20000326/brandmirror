generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id                 String  @id @default(cuid())
  name               String
  industry           String
  websiteUrl         String?
  officialStoreUrl   String?
  description        String?
  coreProducts       String?
  targetAudience     String?
  priceTier          String?
  desiredPositioning String?
  desiredKeywords    String?
  aliasesJson        String?
  status             String  @default("draft")

  // Reserved for future auth / billing
  ownerUserId String?
  plan        String?

  competitors   Competitor[]
  questions     Question[]
  scanJobs      ScanJob[]
  brandProfiles BrandProfile[]
  prescriptions Prescription[]
  diagnoses     Diagnosis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Competitor {
  id         String  @id @default(cuid())
  brandId    String
  name       String
  websiteUrl String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id             String  @id @default(cuid())
  brandId        String
  text           String
  questionType   String?
  persona        String?
  scenario       String?
  purchaseIntent String?
  brandPresent   Boolean @default(false)
  source         String  @default("generated")
  enabled        Boolean @default(true)

  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  observations Observation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScanJob {
  id             String @id @default(cuid())
  brandId        String
  status         String @default("pending")
  totalTasks     Int    @default(0)
  completedTasks Int    @default(0)
  failedTasks    Int    @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  analysisStatus      String    @default("not_started")
  analyzedTasks       Int       @default(0)
  analysisFailedTasks Int       @default(0)
  analysisStartedAt   DateTime?
  analysisCompletedAt DateTime?
  analyzerVersion     String?

  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  observations Observation[]
  modelUsage   ModelUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Observation {
  id         String @id @default(cuid())
  scanJobId  String
  questionId String

  provider String
  model    String

  rawResponse String?

  brandMentioned Boolean?
  brandRank      Int?
  recommended    Boolean?

  competitorsJson String?
  attributesJson  String?
  analysisJson    String?

  status       String  @default("pending")
  errorMessage String?

  // Day 3 scan metadata — keep API vs consumer-app results separate
  surfaceType   String  @default("model_api")
  searchEnabled Boolean @default(false)
  latencyMs     Int?
  attemptCount  Int     @default(0)
  responseId    String?
  promptVersion String  @default("consumer-baseline-v0.1")
  finishReason  String?

  analysisStatus       String  @default("not_started")
  analysisAttemptCount Int     @default(0)
  analysisErrorMessage String?
  analyzerVersion      String?

  scanJob  ScanJob  @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandProfile {
  id                  String  @id @default(cuid())
  brandId             String
  scanJobId           String?
  aiBrandScore        Float?
  awarenessScore      Float?
  recommendationScore Float?
  discoveryScore      Float?
  accuracyScore       Float?
  competitorScore        Float?
  hallucinationRiskScore Float?
  providerMetricsJson    String?
  profileJson            String?
  portraitJson           String?
  summary                String?
  profileEngineVersion   String?
  diagnosisEngineVersion String?
  prescriptionEngineVersion String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Diagnosis {
  id              String   @id @default(cuid())
  brandId         String
  scanJobId       String
  code            String
  severity        String
  title           String
  finding         String?
  evidenceJson    String?
  businessMeaning String?
  confidence      Float?
  engineVersion   String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Prescription {
  id             String  @id @default(cuid())
  brandId        String
  scanJobId      String?
  priority       Int
  title          String
  evidence       String?
  diagnosis      String?
  action         String?
  status         String  @default("active")
  category       String?
  expectedEffect String?
  difficulty     String?
  timeHorizon    String?
  engineVersion  String?
  evidenceSource String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModelUsage {
  id               String  @id @default(cuid())
  scanJobId        String?
  provider         String
  model            String
  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)
  totalTokens      Int     @default(0)
  estimatedCost    Float   @default(0)
  currency         String?
  pricingVersion   String?

  scanJob ScanJob? @relation(fields: [scanJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
